# Flask Settings
SECRET_KEY=medifind-super-secret-key-change-in-production-2026
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Database Settings
# For SQLite (default development fallback):
DATABASE_URL=sqlite:///medifind.db
# For MySQL:
# DATABASE_URL=mysql+pymysql://medifind_user:password123@localhost:3306/medifind_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=medifind_db
MYSQL_USER=medifind_user
MYSQL_PASSWORD=password123

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
